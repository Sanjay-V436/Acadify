generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum ProjectStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  PUBLISHED
}

enum ResourceType {
  PDF
  PPT
  DOCX
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String
  name              String
  role              Role
  bio               String?
  programme         String?
  studentId         String?     @unique
  academicInterests String[]
  careerInterests   String[]
  skills            String[]
  githubUrl         String?
  linkedinUrl       String?
  portfolioUrl      String?
  currentSemester   Int?
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  classId           String?
  class             Class?      @relation(fields: [classId], references: [id])
  createdAt         DateTime    @default(now())

  facultyProfile    FacultyProfile?
  uploadedResources Resource[]
  projectsAsStudent ProjectStudent[]
}

model Department {
  id   String @id @default(uuid())
  name String
  code String @unique

  subjects Subject[]
  students User[]
  classes  Class[]
}

model Subject {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  semester     Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  teachingAssignments TeachingAssignment[]
  resources           Resource[]
}

model Class {
  id              String     @id @default(uuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  batchYear       Int
  section         String?
  currentSemester Int        @default(1)

  students            User[]
  teachingAssignments TeachingAssignment[]

  @@unique([departmentId, batchYear, section])
}

model TeachingAssignment {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id])
  facultyId String
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id])

  @@unique([classId, subjectId])
}

model FacultyProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  designation           String?
  bio                   String?
  qualification         String?
  experienceYears       Int?
  researchInterests     String[]
  currentResearch       String?
  skills                String[]
  specialization        String?
  preferredDomains      String[]
  preferredTechnologies String[]
  facultyWebpageUrl     String?
  googleScholarUrl      String?
  orcidUrl              String?
  linkedinUrl           String?

  availableForProjects Boolean @default(true)
  maxStudents          Int     @default(4)
  currentStudents      Int     @default(0)

  projectsAsMentor    Project[]
  teachingAssignments TeachingAssignment[]
}

model Project {
  id                 String        @id @default(uuid())
  title              String
  description        String
  technologies       String[]
  domain             String
  status             ProjectStatus @default(PROPOSED)
  githubUrl          String?
  liveDemoUrl        String?
  imageUrl           String?
  startDate          DateTime?
  expectedCompletion DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  mentorId String?
  mentor   FacultyProfile? @relation(fields: [mentorId], references: [id], onDelete: Restrict)

  students ProjectStudent[]
}

model ProjectStudent {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
}

model Resource {
  id        String       @id @default(uuid())
  title     String
  fileUrl   String
  type      ResourceType
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}
